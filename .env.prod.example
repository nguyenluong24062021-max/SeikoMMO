# =====================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================
# 
# CRITICAL: DO NOT commit the actual .env.prod file to git!
# This is a TEMPLATE only. Copy to .env.prod and fill in real values.
#
# Setup:
# 1. cp .env.prod.example .env.prod
# 2. Generate secure secrets (see commands below)
# 3. Fill in real API keys from providers
# 4. Verify SEPAY_ALLOW_UNSIGNED=false
# 5. Set proper URLs for your domain
#

# =====================================
# Database (PostgreSQL)
# =====================================
# Container will use postgres:postgres by default
# Change these for production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-postgres-password-here
POSTGRES_DB=seiko_mmo

# Full connection string (used by API container)
# Will be auto-constructed in docker-compose, but can override:
DATABASE_URL="postgresql://postgres:your-strong-postgres-password-here@postgres:5432/seiko_mmo?schema=public"

# =====================================
# Redis Cache
# =====================================
REDIS_URL="redis://redis:6379"

# =====================================
# JWT Authentication
# =====================================
# CRITICAL: Generate 32+ character random secrets
# 
# Generate with:
#   PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Minimum 0 -Maximum 256}))
#   Linux/Mac: openssl rand -base64 32
#   Node.js:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
JWT_ACCESS_SECRET="REPLACE-WITH-32-PLUS-CHAR-RANDOM-STRING-ACCESS"
JWT_REFRESH_SECRET="REPLACE-WITH-32-PLUS-CHAR-RANDOM-STRING-REFRESH"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# =====================================
# SePay Payment Gateway (Bank Transfer)
# =====================================
# Get from SePay dashboard: https://sepay.vn
SEPAY_SECRET="your-production-sepay-secret-key-from-dashboard"
SEPAY_MERCHANT="your-production-merchant-id"

# CRITICAL SECURITY: MUST be false in production
# Setting this to true allows fake payments without signature verification
SEPAY_ALLOW_UNSIGNED=false

# =====================================
# Crypto Payment Gateway (NowPayments)
# =====================================
# For production, use real gateway URL
# For local testing with docker, use mock://dev
CRYPTO_GATEWAY_URL="https://api.nowpayments.io"

# Get from NowPayments dashboard: https://nowpayments.io
NOWPAYMENTS_API_KEY="your-production-nowpayments-api-key"
NOWPAYMENTS_IPN_SECRET="your-production-ipn-secret-for-hmac-verification"

# VND to USD exchange rate (static fallback)
# Update periodically or integrate with exchange rate API
CRYPTO_VND_RATE="26000"

# =====================================
# SMM Provider Encryption
# =====================================
# CRITICAL: 32-character encryption key for API key storage
# 
# Generate with:
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
#   Linux/Mac: openssl rand -hex 32
#   Node.js:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   MUST be 64 hex chars (32 bytes) or API refuses to boot.
#
PROVIDER_KEY_SECRET="REPLACE-WITH-64-HEX-CHARS-32-BYTES-KEY-0000000000000000"

# =====================================
# Application URLs
# =====================================
# API base URL (for webhook callbacks from payment providers)
# MUST be publicly accessible for production
API_BASE_URL="https://api.yourdomain.com"

# Web frontend URL (for CORS)
WEB_URL="https://yourdomain.com"

# Next.js public API URL (used by browser)
# Use full domain in production, container name in docker network
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# =====================================
# Server Configuration
# =====================================
NODE_ENV=production
PORT=3001

# =====================================
# SECURITY CHECKLIST BEFORE DEPLOY
# =====================================
# [ ] JWT secrets are 32+ random characters (both ACCESS and REFRESH)
# [ ] SEPAY_ALLOW_UNSIGNED is set to false
# [ ] SEPAY_SECRET is production key (not test key)
# [ ] NOWPAYMENTS keys are production keys
# [ ] PROVIDER_KEY_SECRET is 64 hex chars (openssl rand -hex 32)
# [ ] DATABASE_URL password is strong (16+ chars, mixed case, numbers, symbols)
# [ ] POSTGRES_PASSWORD matches DATABASE_URL password
# [ ] API_BASE_URL is publicly accessible (for webhooks)
# [ ] WEB_URL matches your actual domain
# [ ] NEXT_PUBLIC_API_URL is accessible from browser
# [ ] All "REPLACE-WITH" placeholders are replaced
# [ ] .env.prod is in .gitignore (DO NOT commit secrets!)
#
# =====================================
# DEPLOYMENT NOTES
# =====================================
# 
# 1. Migrations:
#    Run migrations IN ORDER before starting containers:
#    - 008_add_flash_sales.sql
#    - 009_add_referral_system.sql
#    - 010_timezone_to_timestamptz.sql
#    - 011_add_smm_providers.sql
#    - 012_add_crypto_payment_provider.sql
#    - set_timezone_utc.sql
#
# 2. First-time setup:
#    docker compose -f docker-compose.prod.yml up -d postgres redis
#    # Wait for postgres to be ready
#    # Run migrations (see docs/PROD.md)
#    docker compose -f docker-compose.prod.yml up -d api web
#
# 3. Health checks:
#    curl http://localhost:3001/health  # API
#    curl http://localhost:3000         # Web
#
# 4. Backup:
#    Setup automated backups (see scripts/backup-db.bat or backup-db.sh)
#    Schedule with Task Scheduler (Windows) or cron (Linux)
#
# See docs/PROD.md for complete deployment guide
