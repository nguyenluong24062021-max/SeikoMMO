# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seiko_mmo?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# SePay Payment Gateway (Bank Transfer)
SEPAY_SECRET="your-sepay-secret-key-for-webhook-signature-verification"
SEPAY_MERCHANT="SEIKO_MMO"

# Crypto Payment Gateway (NowPayments)
# Use mock://dev for local development (no API key needed)
# Use real gateway URL for production with actual API keys
CRYPTO_GATEWAY_URL="mock://dev"
NOWPAYMENTS_API_KEY="your-nowpayments-api-key-from-dashboard"
NOWPAYMENTS_IPN_SECRET="your-nowpayments-ipn-secret-for-webhook-verification"
CRYPTO_VND_RATE="26000"

# SMM Provider (for auto-placement)
PROVIDER_KEY_SECRET="your-32-character-encryption-key-change-in-production"

# App
PORT=3001
API_BASE_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NODE_ENV="development"
